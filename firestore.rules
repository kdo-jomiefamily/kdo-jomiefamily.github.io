rules_version = '2';
// KDO security rules.
// Promises: the owner of a list never sees reservations or proposals made for them,
// wishes limited to some people are never sent to anyone else, and private ideas are only readable by their author.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function fam(fid) { return /databases/$(database)/documents/families/$(fid); }
    function profilePath(fid, pid) { return /databases/$(database)/documents/families/$(fid)/profiles/$(pid); }
    function itemPath(fid, iid) { return /databases/$(database)/documents/families/$(fid)/items/$(iid); }

    // A member is a signed-in person who has their own (non-managed) profile in this family
    function member(fid) {
      return signedIn()
        && exists(profilePath(fid, request.auth.uid))
        && get(profilePath(fid, request.auth.uid)).data.managed == false;
    }
    // Relatives without the app (baby, kids, pets...) have a "managed" profile any member can look after
    function isManaged(fid, pid) {
      return exists(profilePath(fid, pid)) && get(profilePath(fid, pid)).data.managed == true;
    }
    function canManage(fid, ownerId) {
      return ownerId == request.auth.uid || isManaged(fid, ownerId);
    }
    function optString(d, key, max) {
      return d.get(key, '') == '' || (d[key] is string && d[key].size() <= max);
    }
    function optPhoto(d, max) {
      return d.get('photo', null) == null || (d.photo is string && d.photo.size() < max);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'avatar', 'photo', 'managed', 'login', 'createdAt', 'createdBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.avatar is map
        && optPhoto(d, 400000)
        && d.managed is bool;
    }
    function validItem(d) {
      return d.keys().hasOnly(['ownerId', 'title', 'url', 'price', 'note', 'photo', 'imageUrl', 'createdAt', 'createdBy', 'removed', 'removedBy', 'removedAt', 'everyone', 'visibleTo'])
        && d.ownerId is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && optString(d, 'url', 2000) && optString(d, 'price', 20) && optString(d, 'note', 300) && optString(d, 'imageUrl', 2000)
        && optPhoto(d, 600000)
        && d.get('removed', false) is bool
        && d.get('everyone', true) is bool
        && d.get('visibleTo', []) is list && d.get('visibleTo', []).size() <= 40;
    }
    // Who may see a wish: its owner, everyone if shared with the whole family, or the people it was limited to
    function canSeeItem(d) {
      return d.ownerId == request.auth.uid
        || d.get('everyone', false) == true
        || request.auth.uid in d.get('visibleTo', []);
    }
    function validProposal(d) {
      return d.keys().hasOnly(['forId', 'by', 'title', 'url', 'price', 'note', 'photo', 'imageUrl', 'status', 'votes', 'joiners', 'createdAt', 'decidedAt'])
        && d.forId is string && d.by is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && optString(d, 'url', 2000) && optString(d, 'price', 20) && optString(d, 'note', 300) && optString(d, 'imageUrl', 2000)
        && optPhoto(d, 600000)
        && d.status in ['question', 'decided']
        && d.votes is map && d.votes.size() <= 60
        && d.get('joiners', {}) is map && d.get('joiners', {}).size() <= 60;
    }
    // Someone else changing only their own entry in a map (a vote, or joining a group gift)
    function onlyMyKey(after, before) {
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }
    function validIdea(d) {
      return d.keys().hasOnly(['forId', 'by', 'title', 'url', 'price', 'note', 'photo', 'imageUrl', 'createdAt'])
        && d.forId is string && d.by == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && optString(d, 'url', 2000) && optString(d, 'price', 20) && optString(d, 'note', 300) && optString(d, 'imageUrl', 2000)
        && optPhoto(d, 600000);
    }

    match /families/{fid} {
      // Knowing the family code is what lets someone in
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;

      match /profiles/{pid} {
        // Names and avatars are needed on the "who are you?" screen, before signing in
        allow read: if true;
        allow create: if signedIn() && exists(fam(fid)) && validProfile(request.resource.data) && (
            // My own profile: once, at sign-up, and its id is my account id
            (pid == request.auth.uid && request.resource.data.managed == false
              && request.resource.data.login is string)
            // A relative without the app, added by a member
            || (member(fid) && request.resource.data.managed == true
              && request.resource.data.createdBy == request.auth.uid
              && !('login' in request.resource.data))
          );
        // Name, photo and avatar can change. Who the profile belongs to never does.
        allow update: if signedIn()
          && (pid == request.auth.uid || (member(fid) && resource.data.managed == true))
          && validProfile(request.resource.data)
          && request.resource.data.managed == resource.data.managed
          && request.resource.data.get('login', null) == resource.data.get('login', null)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
        // Only relatives without the app can be deleted; nobody can delete a real person
        allow delete: if member(fid) && resource.data.managed == true;
      }

      match /items/{iid} {
        allow read: if member(fid) && canSeeItem(resource.data);
        allow create: if member(fid)
          && validItem(request.resource.data)
          && canManage(fid, request.resource.data.ownerId)
          && request.resource.data.createdBy == request.auth.uid
          // Wishes of relatives without the app are always visible to the whole family
          && (request.resource.data.ownerId == request.auth.uid || request.resource.data.get('everyone', true) == true);
        allow update: if member(fid)
          && canManage(fid, resource.data.ownerId)
          && validItem(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.ownerId == request.auth.uid || request.resource.data.get('everyone', true) == true);
        // Normally items are only marked "removed" so reservers get told; real deletion is for removed relatives
        allow delete: if member(fid) && canManage(fid, resource.data.ownerId);
      }

      match /reservations/{iid} {
        // Nobody can read the reservations made on their own list
        allow read: if member(fid) && resource.data.ownerId != request.auth.uid;
        allow create: if member(fid)
          && request.resource.data.keys().hasOnly(['ownerId', 'by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.ownerId != request.auth.uid
          && exists(itemPath(fid, iid))
          && get(itemPath(fid, iid)).data.ownerId == request.resource.data.ownerId
          && get(itemPath(fid, iid)).data.get('removed', false) == false
          && canSeeItem(get(itemPath(fid, iid)).data);
        // Only the person who reserved can release it. No overwriting someone else's reservation.
        allow delete: if member(fid) && resource.data.by == request.auth.uid;
        // Group gift: others can only add or remove themselves as participants
        allow update: if member(fid)
          && resource.data.ownerId != request.auth.uid
          && resource.data.by != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joiners'])
          && request.resource.data.joiners is map && request.resource.data.joiners.size() <= 40
          && onlyMyKey(request.resource.data.joiners, resource.data.get('joiners', {}))
          && canSeeItem(get(itemPath(fid, iid)).data);
      }

      match /proposals/{pid} {
        // Gifts the family discusses for someone: that person can never read them
        allow read: if member(fid) && resource.data.forId != request.auth.uid;
        allow create: if member(fid)
          && validProposal(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.forId != request.auth.uid
          && exists(profilePath(fid, request.resource.data.forId));
        allow update: if member(fid)
          && resource.data.forId != request.auth.uid
          && validProposal(request.resource.data)
          && request.resource.data.by == resource.data.by
          && request.resource.data.forId == resource.data.forId
          && (
            // The person who proposed it can change it
            resource.data.by == request.auth.uid
            // Everyone else can only change their own vote, or join / leave the group gift themselves
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'joiners'])
              && onlyMyKey(request.resource.data.votes, resource.data.votes)
              && onlyMyKey(request.resource.data.get('joiners', {}), resource.data.get('joiners', {})))
          );
        allow delete: if member(fid) && resource.data.by == request.auth.uid;
      }

      match /ideas/{iid} {
        // Private ideas: only their author can read or change them
        allow read, delete: if signedIn() && resource.data.by == request.auth.uid;
        allow create: if member(fid) && validIdea(request.resource.data);
        allow update: if signedIn() && resource.data.by == request.auth.uid && validIdea(request.resource.data);
      }

      match /stories/{sid} {
        allow read: if member(fid);
        allow create: if member(fid)
          && request.resource.data.keys().hasOnly(['by', 'photo', 'caption', 'createdAt', 'expiresAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.photo is string && request.resource.data.photo.size() < 950000
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 150
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt <= request.time.toMillis() + 172920000;
        // The author can delete it anytime; after 48 h, anyone in the family can clear it out
        allow delete: if member(fid) && (resource.data.by == request.auth.uid || resource.data.expiresAt < request.time.toMillis());
        allow update: if false;
      }
    }
  }
}
